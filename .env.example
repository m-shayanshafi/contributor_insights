# Copy to .env (never commit .env) and fill in values.

# Data source: "github" (live, needs GITHUB_TOKEN) or "fixtures" (recorded data, no token).
DATA_SOURCE=fixtures
# LLM mode: "live" (needs GEMINI_API_KEY) or "recorded" (recorded responses, no key).
LLM_MODE=recorded

# Fine-grained PAT: "Public repositories (read-only)", no permissions, short expiry.
GITHUB_TOKEN=
# Gemini API key from Google AI Studio (free tier works).
GEMINI_API_KEY=

# Optional overrides (defaults shown).
# TARGET_REPO=home-assistant/core
# GEMINI_MODEL=gemini-3.5-flash-lite
# DB_PATH=data/insights.db
# SYNC_TTL_SECONDS=3600
# HISTORY_DAYS=180
# MAX_CONCURRENT_BACKFILLS=2
# MAX_NEW_CONTRIBUTORS_PER_HOUR=20
# RATE_LIMIT=30/minute
